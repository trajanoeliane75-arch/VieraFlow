name: Android build and tests
on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:
jobs:
  test-build:
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
      - name: Install Android SDK
        run: |
          yes | "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" --licenses >/dev/null || true
          "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" 'platforms;android-35' 'build-tools;35.0.0'
      - name: Run integration tests
        run: bash tests/run.sh tests/fixtures
      - name: Build debug APK
        run: bash build.sh
      - name: Upload debug APK
        uses: actions/upload-artifact@v4
        with:
          name: VieraFlow-0.2.0-rc1-test-apk
          path: VieraFlow-0.2.0-rc1-debug.apk
          if-no-files-found: error
